OPENAI_API_KEY=
MINIMAX_API_KEY=

# Subtitle extraction / transcription.
# The app first tries uploaded sidecar subtitles and embedded subtitle streams.
# If neither exists, TRANSCRIBE_PROVIDER controls automatic speech recognition.
# auto = OpenAI transcription if OPENAI_API_KEY/TRANSCRIBE_API_KEY exists, otherwise local faster-whisper if installed.
TRANSCRIBE_PROVIDER=auto
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local ASR fallback. Optional install:
# .\.venv\Scripts\python.exe -m pip install faster-whisper
# CPU examples: WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8.
# NVIDIA GPU examples: WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_INITIAL_PROMPT=这是一段中文影视剧对白，请保留人物称呼、口语语气和剧情相关词汇。

# OpenAI-compatible text generation provider.
# MiniMax official OpenAI-compatible API:
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=your-minimax-api-key
LLM_MODEL=MiniMax-M2.7
#
# Kimi example:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=your-kimi-key
# LLM_MODEL=kimi-k2-0905-preview
#
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-key
# LLM_MODEL=deepseek-chat

# TTS provider. Values: openai, minimax, openai-compatible, minimax-official, xiaomi, mimo.
TTS_PROVIDER=minimax-official
TTS_API_KEY=your-minimax-api-key
TTS_BASE_URL=https://api.minimaxi.com/v1
TTS_MODEL=speech-2.8-hd
TTS_VOICE=male-qn-qingse

# Xiaomi MiMo OpenAI-compatible TTS example.
# TTS_PROVIDER=xiaomi
# TTS_API_KEY=your-mimo-api-key
# TTS_BASE_URL=https://api.xiaomimimo.com/v1
# TTS_MODEL=mimo-v2.5-tts
# TTS_VOICE=mimo_default

# Optional legacy MiniMax group id. Leave empty for the current official API.
MINIMAX_GROUP_ID=

# Token Plan multimodal quota model names.
IMAGE_BASE_URL=https://api.minimaxi.com/v1
IMAGE_MODEL=image-01
VIDEO_BASE_URL=https://api.minimaxi.com/v1
VIDEO_MODEL=video-01
MUSIC_BASE_URL=https://api.minimaxi.com/v1
MUSIC_MODEL=music-2.6
MUSIC_COVER_MODEL=music-cover
LYRICS_MODEL=lyrics_generation
