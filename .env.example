OPENAI_API_KEY=
MINIMAX_API_KEY=

# OpenAI-compatible text generation provider.
# MiniMax official OpenAI-compatible API:
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=your-minimax-api-key
LLM_MODEL=MiniMax-M2.7
#
# Kimi example:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=your-kimi-key
# LLM_MODEL=kimi-k2-0905-preview
#
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-key
# LLM_MODEL=deepseek-chat

# TTS provider. Values: openai, minimax, openai-compatible, minimax-official.
TTS_PROVIDER=minimax-official
TTS_API_KEY=your-minimax-api-key
TTS_BASE_URL=https://api.minimaxi.com/v1
TTS_MODEL=speech-2.8-hd
TTS_VOICE=male-qn-qingse

# Optional legacy MiniMax group id. Leave empty for the current official API.
MINIMAX_GROUP_ID=

# Token Plan multimodal quota model names.
IMAGE_BASE_URL=https://api.minimaxi.com/v1
IMAGE_MODEL=image-01
VIDEO_BASE_URL=https://api.minimaxi.com/v1
VIDEO_MODEL=video-01
MUSIC_BASE_URL=https://api.minimaxi.com/v1
MUSIC_MODEL=music-2.6
MUSIC_COVER_MODEL=music-cover
LYRICS_MODEL=lyrics_generation
